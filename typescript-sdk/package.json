{
    "name": "space",
    "version": "0.0.1",
    "type": "module",
    "main": "dist/index.js",
    "files": [
        "/dist"
    ],
    "dependencies": {
        "@bufbuild/protobuf": "^2.14.0",
        "@bufbuild/protoc-gen-es": "^2.14.0"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "protoc": "^36.0.0",
        "typescript": "^7.0.2",
        "vitest": "^4.0.18"
    },
    "scripts": {
        "regenerate": "protoc -I . --plugin ./node_modules/.bin/protoc-gen-es --es_out . --es_opt target=ts --es_opt import_extension=js --proto_path=../server/ ../server/*.proto",
        "compile": "tsc",
        "build": "npm run regenerate && npm run compile",
        "test": "npm run regenerate && vitest run --reporter=verbose",
        "harvester": "node dist/demo/harvester/main.js"
    }
}
