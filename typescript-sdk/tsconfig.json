{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "dom"
    ],
    "module": "ES2020",
    "target": "ES2020",
    "outDir": "dist",
    "declaration": true,
    "removeComments": false,

    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "types": ["node"],
    "paths": {},

    "alwaysStrict": true,
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "strictNullChecks": true,

    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "index.ts",
    "*_pb.ts",
    "highlevel/**/*.ts",
    "midlevel/**/*.ts",
    "lowlevel/**/*.ts",
    "transport/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules/**/*",
    "dist/**/*",
    "demo/**/*",
    "tests/**/*",
    "vitest.config.ts"
  ]
}
