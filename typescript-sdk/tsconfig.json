{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "dom"
    ],
    "module": "es6",
    "target": "es6",
    "outDir": "dist",
    "declaration": true,
    "removeComments": false,  // Better for debugging

    // Module resolution
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {},

    // Strict Checks
    "alwaysStrict": true,
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "strictNullChecks": true,

    // Linter Checks
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["*.ts"],
  "exclude": [
    "node_modules/**/*"
  ]
}
